# Origin lock: every hostname here is proxied by Cloudflare, so a peer outside
# its edge ranges has bypassed the WAF and bot controls and is dropped before
# any route runs. The Caddyfile orders abort ahead of handle and redir so this
# covers every route. Private ranges stay allowed: no internet peer can complete
# a handshake from one, and they keep on-box probes and local development
# working. Ranges from https://www.cloudflare.com/ips/ (checked 2026-10-28);
# keep them in step with trusted_proxies in the Caddyfile.
(jw_cloudflare_only) {
    @jw_not_cloudflare not remote_ip private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    abort @jw_not_cloudflare
}

# No forward_auth runs on these sites, so nothing would overwrite a
# client-supplied identity header: it would reach the apps and fill the user
# field of the access log. Drop all three on the way in.
(jw_strip_client_identity) {
    request_header -Remote-User
    request_header -Remote-Email
    request_header -Remote-Groups
}

# The scaffold renderer requires every reverse_proxy to strip the auth
# gateway's session cookie. This host runs no gateway, so there is no such
# cookie to strip, and each proxy below carries the renderer's allow marker.

# Redirect www to apex
www.{$DOMAIN} {
    import jw_cloudflare_only
    redir https://{$DOMAIN}{uri} permanent
}

# Journal Watch — main app
# (Keep comments free of curly braces: the scaffold renderer counts braces.)
{$DOMAIN} {
    # Per-request JSON access logging (/var/log/caddy/access.log on the
    # caddy_logs volume, size-capped rotation), compression and baseline
    # security headers are injected into every site by
    # scaffold/docker/render-caddy-routes.sh — don't redeclare them here.
    import jw_cloudflare_only
    import jw_strip_client_identity

    # Security headers (in addition to the scaffold baseline)
    header {
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    handle_path /static/* {
        root * /srv/static/journal-watch

        @immutable path_regexp immutable ^.+(?:[.-][0-9a-f]{8,64})\..+$
        @nonimmutable not path_regexp immutable ^.+(?:[.-][0-9a-f]{8,64})\..+$

        header @immutable Cache-Control "public, max-age=31536000, immutable"
        header @nonimmutable Cache-Control "public, max-age=3600"

        file_server {
            precompressed br gzip
        }
    }

    # Media — proxy to S3 so images are same-origin (one H2 connection, no
    # per-image DNS/TLS to S3) and Cloudflare can edge-cache them. Requires
    # DJANGO_AWS_S3_CUSTOM_DOMAIN set to the site domain in the app env, which
    # rewrites MEDIA_URL to https://<domain>/media/. S3 object keys already
    # start with "media/", so the request path maps 1:1 — no rewrite needed.
    #
    # `immutable` is the piece the S3 headers were missing: without it,
    # Safari/Firefox revalidate every image on reload, repainting the
    # placeholder frames while they wait (the homepage flicker).
    #
    # The proxy is read-only: only GET and HEAD reach S3, and the query string
    # is dropped, so a request cannot ask S3 for an object version, an ACL or
    # any other subresource. Media URLs carry no query string of their own.
    handle /media/* {
        @jw_media_not_read not method GET HEAD
        respond @jw_media_not_read 405
        rewrite * {path}?

        header {
            Cache-Control "public, max-age=604800, immutable"
            -x-amz-server-side-encryption
            -x-amz-version-id
            defer
        }
        # The whole Cookie header is removed here, not just a gateway cookie.
        # scaffold-lint: allow-session-cookie
        reverse_proxy https://spanza-journal-watch-production-v2.s3.amazonaws.com {
            header_up Host spanza-journal-watch-production-v2.s3.amazonaws.com
            header_up -Cookie
        }
    }

    # X-Forwarded-For is set to the client address Caddy has already taken
    # from CF-Connecting-IP, rather than passing on a chain whose first entry
    # the visitor can write.
    # scaffold-lint: allow-session-cookie
    reverse_proxy journal-watch:5000 {
        header_up X-Forwarded-For {client_ip}
    }
}

# Planka — project management, signed in from the Journal Watch session.
#
# Planka (our build, github.com/uppertoe/kanban-gateway-signin) trusts the
# Remote-Email and Remote-Groups headers only alongside X-Gateway-Secret,
# which this block injects from PLANKA_GATEWAY_SECRET. Before any request is
# forwarded, forward_auth asks Django at /planka/check with the visitor's
# cookies: a 204 carries the two headers, which are copied onto the request;
# any other answer (a redirect to Django's own /planka/ sign-in page) goes
# back to the browser as it is. The check covers the whole site, API and
# socket handshake included, because Planka re-checks the identity on every
# request. Django sees the Journal Watch session here because its cookie is
# set on the parent domain.
#
# Everything sits inside one route block so the gate runs before the cover
# handle: in Caddy's default directive order a bare handle would run BEFORE
# forward_auth. header_up REPLACES the header, so a client-sent
# X-Gateway-Secret never survives, and jw_strip_client_identity drops any
# client-sent Remote-* before the copy. Keep this comment free of curly
# braces: the route renderer counts them.
planka.{$DOMAIN} {
    import jw_cloudflare_only

    @custom_cover path_regexp cover ^/assets/(login-)?cover-[A-Za-z0-9_-]+\.jpg$

    route {
        import jw_strip_client_identity
        request_header -X-Gateway-Secret

        # journal-watch is the Django service's name on the proxy network that
        # Caddy shares; the jw-django alias exists only on the internal networks.
        forward_auth journal-watch:5000 {
            uri /planka/check
            copy_headers Remote-Email Remote-User Remote-Groups
            header_up X-Forwarded-For {client_ip}
        }

        # /srv/planka is apps/journal-watch/planka, mounted read-only in
        # docker-compose.yml. The cover shows only when a sign-in has been
        # refused, since the gateway signs everyone else straight in. The
        # file never changes without a new filename, so browsers and
        # Cloudflare may keep it for a year.
        handle @custom_cover {
            root * /srv/planka
            rewrite * /cover-journalwatch.webp
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }

        # X-Forwarded-For is set to the client address Caddy has already
        # taken from CF-Connecting-IP, rather than passing on a chain whose
        # first entry the visitor can write. Planka's uploads routes now
        # send a correct max-age themselves (fixed in 2.2.1), so the old
        # header rewrite for Firefox is gone.
        handle {
            # scaffold-lint: allow-session-cookie
            reverse_proxy jw_planka:1337 {
                header_up X-Forwarded-For {client_ip}
                header_up X-Gateway-Secret {$PLANKA_GATEWAY_SECRET}
            }
        }
    }
}

# Flower (Celery monitoring) is not deployed: the jw_flower service sits behind
# the compose "flower" profile, which is not enabled, and flower.journalwatch
# has no DNS record. An unconditional site block here made Caddy retry an ACME
# challenge for the name every few minutes. To bring Flower back, add the DNS
# record, enable the profile, and restore a flower.DOMAIN site block that
# reverse-proxies to jw_flower:5555. Keep this comment free of curly braces:
# the route renderer treats them as block delimiters.
