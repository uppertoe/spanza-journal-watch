# =============================================================================
# Journal Watch — app environment for the server repo (hardened-Caddy scaffold)
# Place at apps/journal-watch/.env (never commit the populated file).
#
# The root docker-compose.yml pulls in apps/journal-watch/docker-compose.yml
# through `include:`, so Compose reads this file for variable substitution on
# its own — no need to source it first. deploy/bootstrap/gen-env.sh in the app
# repo writes a complete starting copy with the secrets already generated.
# =============================================================================


# =============================================================================
# Docker Hub
# =============================================================================

JW_DOCKERHUB_NAMESPACE=your-dockerhub-namespace
JW_APP_TAG=latest


# =============================================================================
# Django
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.production

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated allowed hostnames
DJANGO_ALLOWED_HOSTS=.journalwatch.org.au,jw-django

# TLS is terminated by Caddy — keep False
DJANGO_SECURE_SSL_REDIRECT=False

DJANGO_DEFAULT_FROM_EMAIL="Journal Watch <noreply@journalwatch.org.au>"
DJANGO_SERVER_EMAIL="Journal Watch <noreply@journalwatch.org.au>"

# Obfuscate the admin URL with a random path segment
DJANGO_ADMIN_URL=change-me-random-path/

DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Gunicorn workers — rule of thumb: 2 × CPU cores + 1
WEB_CONCURRENCY=3


# =============================================================================
# PostgreSQL (Django database)
# =============================================================================

POSTGRES_DB=spanza_journal_watch
POSTGRES_USER=jw
# python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=


# =============================================================================
# AWS (S3 media storage + SES transactional email)
# =============================================================================

DJANGO_AWS_ACCESS_KEY_ID=
DJANGO_AWS_SECRET_ACCESS_KEY=
DJANGO_AWS_STORAGE_BUCKET_NAME=your-bucket-name
DJANGO_AWS_S3_REGION_NAME=ap-southeast-2
DJANGO_AWS_DEFAULT_REGION=ap-southeast-2

# Serve media through the site domain instead of direct S3 URLs. Caddy proxies
# /media/* to the S3 bucket (see journalwatch.caddy), so images share the
# page's H2 connection and get edge-cached by Cloudflare.
DJANGO_AWS_S3_CUSTOM_DOMAIN=journalwatch.org.au

# S3 prefix for inbound emails stored by SES receive action
DJANGO_ANYMAIL_INBOUND_S3_OBJECT_PREFIX=email

# Generate a username:password pair for Anymail webhook basic auth, for example:
#   python -c "import secrets; print(f'{secrets.token_urlsafe(12)}:{secrets.token_urlsafe(18)}')"
# Put this exact value into the SNS subscription URL that aws_setup.py prints later.
# Django does NOT receive SNS events until you run that aws sns subscribe command.
# This secret lets Django reject unexpected webhook traffic.
WEBHOOK_SECRET=

# SES configuration set — use TrackingConfigSet-staging for staging
ANYMAIL_CONFIGURATION_SET_NAME=TrackingConfigSet


# =============================================================================
# Celery / Flower
# =============================================================================

# python -c "import secrets; print(secrets.token_urlsafe(16))"
CELERY_FLOWER_USER=flower
CELERY_FLOWER_PASSWORD=


# =============================================================================
# Sentry (optional — leave blank to disable)
# =============================================================================

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1


# =============================================================================
# Planka integration (Django → Planka API)
# =============================================================================

# Public URL where Planka is reachable (used for links in the Django UI)
PLANKA_EXTERNAL_URL=https://planka.journalwatch.org.au

# Must match DEFAULT_ADMIN_EMAIL below
PLANKA_ADMIN_EMAIL=admin@journalwatch.org.au


# =============================================================================
# Planka application
#
# Planka does not read this whole file. It receives only the variables named
# under jw_planka in docker-compose.yml, so a new Planka setting added here
# must also be added to that list.
# =============================================================================

BASE_URL=https://planka.journalwatch.org.au

# openssl rand -hex 32
SECRET_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(24))"
PLANKA_POSTGRES_PASSWORD=

# Redis password (job queue and cache). Hex, so it needs no escaping in REDIS_URL.
JW_REDIS_PASSWORD=

USER_TERMS_OF_SERVICE_VERSION=1

# Sign-in: Planka takes the identity from Django's gateway check. Caddy adds
# this secret to every request it forwards to Planka, and Planka accepts no
# identity without it; both read it from here through compose.
# openssl rand -hex 32
PLANKA_GATEWAY_SECRET=

DEFAULT_ADMIN_NAME=Journal Watch Admin
DEFAULT_ADMIN_USERNAME=admin
# Set once at first boot, then remove from this file:
DEFAULT_ADMIN_PASSWORD=

#Generate the secret with:
#python -c "import secrets; print(secrets.token_urlsafe(32))"
PLANKA_WEBHOOK_SECRET=




# =============================================================================
# Planka — S3 object storage
# Use a SEPARATE IAM user and a SEPARATE bucket for Planka.
# =============================================================================

PLANKA_S3_BUCKET=
PLANKA_S3_ACCESS_KEY_ID=
PLANKA_S3_SECRET_ACCESS_KEY=
PLANKA_S3_REGION=ap-southeast-2

# --- Planka notification email (SES SMTP) ---
# Username is an IAM access key ID permitted to send via SES; the password is
# the SES SMTP password derived from that key's secret (see the SES developer
# guide, "Obtaining Amazon SES SMTP credentials") — nothing is created in AWS.
# Leave SMTP_SECURE unset: 587 is STARTTLS.
PLANKA_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
PLANKA_SMTP_PORT=587
PLANKA_SMTP_USER=
PLANKA_SMTP_PASSWORD=
PLANKA_SMTP_FROM=Journal Watch <admin@journalwatch.org.au>
